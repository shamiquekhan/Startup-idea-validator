# LLM Provider (ollama | groq | gemini)
LLM_PROVIDER=ollama

# Groq (optional — faster inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (optional — fallback when Groq rate-limits)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (default)
OLLAMA_BASE_URL=http://localhost:11434
